{
  "name": "octollm-sdk",
  "version": "0.5.0",
  "description": "Official TypeScript SDK for OctoLLM distributed AI architecture",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "octollm",
    "ai",
    "llm",
    "distributed",
    "security",
    "typescript",
    "sdk"
  ],
  "author": "OctoLLM Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doublegate/OctoLLM.git",
    "directory": "sdks/typescript/octollm-sdk"
  },
  "bugs": {
    "url": "https://github.com/doublegate/OctoLLM/issues"
  },
  "homepage": "https://github.com/doublegate/OctoLLM#readme",
  "dependencies": {
    "axios": ">=1.18.1 <1.19.0",
    "axios-retry": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
