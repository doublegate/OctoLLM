logs/
daily_logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pip-log.txt
pip-delete-this-directory.txt

# ================================================================
# Docker
# ================================================================
docker-compose.override.yml
*.dockerfile.tmp
.docker/

# ================================================================
# Terraform
# ================================================================
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraformrc
terraform.rc
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terragrunt-cache/

# ================================================================
# Kubernetes
# ================================================================
*secret*.yaml
!*secret*.example.yaml
# These two are declaration templates: every value is a secretKeyRef/remoteRef pointing
# at an external store, so no secret material is present. They are tracked deliberately,
# and are named here so that stays an explicit decision rather than a rule that quietly
# does not apply to files already in the index.
!infrastructure/secrets/secret-definitions.yaml
!infrastructure/secrets/kubernetes-integration/external-secrets.yaml
kubeconfig
kubeconfig.*
*.kubeconfig

# ================================================================
# Build Artifacts
# ================================================================
*.tar
*.tar.gz
*.tar.bz2
*.zip
*.jar
*.war
*.nar
*.ear
*.rar
*.7z
dist/
build/
out/

# ================================================================
# OS-Specific
# ================================================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ================================================================
# Temporary Files
# ================================================================
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~.nib
local_settings.py
db.sqlite3
db.sqlite3-journal

# ================================================================
# CI/CD
# ================================================================
.github/**/*.log

# ================================================================
# Monitoring & Observability
# ================================================================
.prometheus/
.grafana/
.jaeger/

# ================================================================
# Project-Specific
# ================================================================
# Local overrides
docker-compose.local.yml
.local/

# Performance profiles
*.prof
*.pprof

# Generated files
*_generated.py
*_generated.rs

# Cache directories.
#
# These are ANCHORED on purpose. A bare `cache/` matches any directory named "cache" at
# any depth, and it was swallowing services/reflex-layer/src/cache/ -- a Rust source
# module, not a cache. Its five files stayed in the index only because they predate the
# rule; any new file added to that module would have been dropped silently.
/.cache/
/cache/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/

# Backup files
*.backup

# ================================================================
# Documentation Build Artifacts
# ================================================================
docs/_build/
docs/.doctrees/
site/

# ================================================================
# Node.js / TypeScript SDK
# ================================================================
node_modules/
npm-debug.log
yarn-error.log
.pnpm-debug.log
.npm
.eslintcache
.node_repl_history
.yarn-integrity
*.tsbuildinfo
# jest --coverage output (the Python "htmlcov/" rule above does not cover this)
sdks/typescript/*/coverage/
# tsc output for the SDK. The generic "dist/" rules above already match it; this is
# spelled out so the SDK's build artefacts are obvious to anyone reading this file.
sdks/typescript/*/dist/

# ================================================================
# END OF .gitignore
# ================================================================
